<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Punto 34: el metapaquete Microsoft.AspNetCore.Mvc.Core 2.1.0 esta fuera de soporte y
         arrastra ensamblados de ASP.NET Core 2.x. En net8.0 lo correcto es referenciar el
         framework compartido, que aporta MVC con la version del runtime en uso. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoralesLarios.OOFP.Core\MoralesLarios.OOFP.Core.csproj" />
    <ProjectReference Include="..\MoralesLarios.OOFP.Shared\MoralesLarios.OOFP.Shared.csproj" />
    <ProjectReference Include="..\MoralesLarios.OOFP.ValueObjects\MoralesLarios.OOFP.ValueObjects.csproj" />
  </ItemGroup>

</Project>
